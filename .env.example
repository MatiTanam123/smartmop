# PostgreSQL local. Ganti password sesuai password PostgreSQL di komputer kamu.
DATABASE_URL=postgresql://postgres:ISI_PASSWORD_POSTGRES@127.0.0.1:5432/smartmop_db

# Flask server
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=true
FLASK_SECRET_KEY=ganti-dengan-random-secret-untuk-lokal

# Device API key: biarkan kosong saat uji lokal awal.
# Jika diisi, ESP32 wajib mengirim header X-Device-Key dengan nilai yang sama.
DEVICE_API_KEY=

# CORS: * hanya untuk pengembangan di jaringan lokal. Batasi origin sebelum dipublikasikan.
CORS_ORIGINS=*

# Maksimal ukuran gambar upload
MAX_UPLOAD_MB=8

# Model ML. Salin model terlatih ke backend/ml/models/best.pt
ML_MODEL_PATH=backend/ml/models/best.pt
ML_IMAGE_SIZE=640

# Perangkat dianggap online jika heartbeat terakhir diterima dalam interval ini.
DEVICE_ONLINE_SECONDS=60
APP_TIMEZONE=Asia/Pontianak
